<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Symfony\Component\HttpFoundation\Response;

class EnsureUserIsReseller
{
    /**
     * Handle an incoming request.
     *
     * @param  \Closure(\Illuminate\Http\Request): (\Symfony\Component\HttpFoundation\Response)  $next
     */
    public function handle(Request $request, Closure $next): Response
    {
        if (!Auth::check()) {
            return redirect()->route('filament.reseller.auth.login');
        }

        $user = Auth::user();
        
        // Super Admin may enter any active reseller account through the administrator portal.
        if ($user->hasRole('Super Admin') && session()->has('reseller_context_id')) {
            $reseller = \App\Models\Reseller::find(session('reseller_context_id'));
            if (! $reseller || ! $reseller->isActive()) {
                session()->forget('reseller_context_id');
                return redirect()->route('dashboard')->with('error', 'The selected reseller is suspended or unavailable.');
            }
            return $next($request);
        }

        // Normal reseller users can only operate their own active account.
        if (! $user->reseller || ! $user->reseller->isActive()) {
            Auth::logout();
            $request->session()->invalidate();
            $request->session()->regenerateToken();
            return redirect()->route('filament.reseller.auth.login')->with('error', 'Your reseller account is suspended or not initialized.');
        }

        return $next($request);
    }
}
