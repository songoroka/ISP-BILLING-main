<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class ForcePortalPasswordChange
{
    public function handle(Request $request, Closure $next): Response
    {
        $user = $request->user();

        if ($user && $user->must_change_password) {
            $path = trim($request->path(), '/');

            if ($path !== 'change-password' && ! str_starts_with($path, 'livewire/')) {
                if (str_starts_with($request->getHost(), 'hotel.')) {
                    $baseDomain = parse_url(config('app.url'), PHP_URL_HOST) ?: config('app.url');
                    $portalDomain = env('ADMIN_PORTAL_DOMAIN', 'admin.' . $baseDomain);
                    return redirect()->away('https://'.$portalDomain.'/change-password');
                }

                return redirect()->to('/change-password');
            }
        }

        return $next($request);
    }
}
